# Copia este archivo con el nombre .env (en esta misma carpeta) y completa los valores en tu computadora.
# El .env nunca se sube a GitHub ni se pega en un chat.

# Apify: console.apify.com → Settings → API & Integrations
APIFY_API_TOKEN=

# Supabase (Partners). La URL no es secreta; la llave sí:
# Supabase → proyecto pixely_partners → Project Settings → API Keys → Legacy API keys → service_role → Reveal
SUPABASE_URL=https://zvpisdftltnukbozyuge.supabase.co
SUPABASE_SERVICE_KEY=

# Carpeta donde están las carpetas de cada cliente (con sus Inputs y Outputs). Con barras normales, ej.:
# CARPETA_CLIENTES=D:/1.-Pixely/Clientes
CARPETA_CLIENTES=
